# --- Google OAuth (Gmail) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Redirect URI is optional: app default is http://localhost:3000/auth/callback (see src/main/auth/googleAuth.js).
# Override only if your Google Cloud OAuth client uses a different redirect.
# GOOGLE_REDIRECT_URI=http://localhost:3000/auth/callback
# Optional: open OAuth in external browser (1 / true)
# GOOGLE_OAUTH_EXTERNAL_BROWSER=

# --- Yahoo OAuth (optional) ---
# YAHOO_CLIENT_ID=
# YAHOO_CLIENT_SECRET=
# YAHOO_REDIRECT_URI=http://localhost:3000/auth/yahoo-callback

# --- electron-store encryption ---
# If unset, a built-in dev fallback key is used (see src/main/storeEncryption.js)
# DB_ENCRYPTION_KEY=

# --- Text extraction HTTP service (voice pipeline) ---
# TEXT_EXTRACTION_URL=http://127.0.0.1:5000
# Set to 0 to disable auto-start behaviour where applicable
# TEXT_EXTRACTION_AUTOSTART=

# --- TTS HTTP service (voice pipeline defaults) ---
# TTS_BASE_URL=http://127.0.0.1:5001

# --- Generic SMTP fallbacks (optional; app may use account-specific settings) ---
# SMTP_HOST=
# SMTP_USER=
# SMTP_PASS=
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_FROM=

# --- Build / dev helpers ---
# PYTHON=C:\Path\To\python.exe
# PYTHON_EXECUTABLE=

# --- Mail integration tests (`npm run test:mail`) ---
# IMAP (e.g. Gmail app password):
# TEST_IMAP_USER=
# TEST_IMAP_PASS=
# TEST_IMAP_HOST=imap.gmail.com
# TEST_IMAP_PORT=993
# Gmail IMAP via OAuth refresh token (same OAuth client as app; scope must allow IMAP):
# TEST_GMAIL_USER=
# TEST_GMAIL_REFRESH_TOKEN=
# SMTP verify (TEST_* overrides generic SMTP_* above):
# TEST_SMTP_HOST=
# TEST_SMTP_USER=
# TEST_SMTP_PASS=
# TEST_SMTP_PORT=465
# TEST_SMTP_SECURE=true
# TEST_SMTP_SEND=0
# TEST_SMTP_TO=
# Optional: MAIL_TEST_ONLY=smtp | imap | oauth
